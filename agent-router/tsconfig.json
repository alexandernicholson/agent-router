{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023"
    ],
    "types": [],
    "jsx": "react",
    "jsxFactory": "h",
    "jsxFragmentFactory": "Fragment",
    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "../shared/types/*.d.ts",
    "hooks/*.ts",
    "hooks/*.tsx",
    "hooks/shared/*.ts",
    "tests/*.ts",
    "lib/routing.js",
    "lib/catalog.js"
  ]
}
